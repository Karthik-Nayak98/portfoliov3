---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import { ANALYTICS } from "../utils/constants";

interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
}

const { title, description = "My portfolio website showcasing my work as a Software & Cloud DevOps Engineer", image = "/web-app-manifest-512x512.png", url = Astro.url.pathname } = Astro.props;
const canonicalUrl = `${Astro.site}${url}`;
const ogImage = image.startsWith('http') ? image : `${Astro.site}${image}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&&family=Lora:ital,wght@1,500&family=Assistant:wght@200..800&display=swap" 
      rel="stylesheet"
    /> 
    <link
      rel="alternate"
      title="Technical blog posts."
      href="/rss.xml"
      type="application/rss+xml"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Karthik Nayak",
      "jobTitle": "Software & Cloud DevOps Engineer",
      "url": Astro.site,
      "image": `${Astro.site}/karthik.webp`,
      "sameAs": [
        "https://www.linkedin.com/in/karthiknayak98/",
        "https://www.github.com/karthik-nayak98/",
        "https://www.twitter.com/karthiknayak98/"
      ]
    })}></script>

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script>
      // Immediately set theme class before page renders
      (function () {
        const theme = localStorage.getItem("theme");
        if (
          theme === "dark" ||
          (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
  </head>

  <!-- Google tag (gtag.js) -->
  {ANALYTICS.gaTrackingId && (
    <>
      <script
        type="text/partytown"
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.gaTrackingId}`}></script>
      <script type="text/partytown" define:vars={{ gaTrackingId: ANALYTICS.gaTrackingId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag("js", new Date());
        gtag("config", gaTrackingId);
      </script>
    </>
  )}

  <body class="bg-secondary dark:bg-dark overflow-y-scroll">
    <Navbar />
    <main
      id="skip-to-content"
      class="dark:bg-dark mx-auto px-4 md:px-12 lg:px-16 md:py-4 max-w-7xl min-h-[calc(100vh-10rem)] container"
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
