---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Header from "../components/Header.astro";
import { getDateValue } from "../utils/date";

type Props = {
  posts: CollectionEntry<"posts">[];
};

const posts = (await getCollection("posts"))
  .map((post) => ({
    ...post,
    data: {
      ...post.data,
      date: getDateValue(post.data.date),
    },
  }))
  .sort((a, b) => b.data.date - a.data.date);
---

<Layout
  title="Blog | Karthik Nayak"
  description="Technical blog posts about software engineering, DevOps, cloud automation, and web development by Karthik Nayak."
>
  <Header title="Blogs" />
  {
    posts.map((post) => (
      <Card
        href={post.slug}
        title={post.data.title}
        excerpt={post.data.excerpt}
        date={post.data.date}
        slug={post.slug}
      />
    ))
  }
</Layout>
