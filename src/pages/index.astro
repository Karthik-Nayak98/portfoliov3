---
import { Image } from "astro:assets";
import karthik from "../assets/karthik.webp";
import Social from "../components/Social.astro";
import social_data from "../data/social.json";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Karthik Nayak">
  <section
    class="flex flex-col justify-center md:justify-around lg:justify-center items-center gap-5 px-4 md:px-0 font-300 font-assistant text-dark dark:text-light"
  >
    <Image
      class="rounded-full w-48 md:w-64 h-48 md:h-64 object-cover"
      src={karthik}
      alt="Karthik Nayak"
      loading="lazy"
      format="webp"
    />
    <section>
      <article
        class="flex flex-col items-center max-w-none dark:text-light prose-a:text-accent leading-7 prose"
      >
        <span
          class="font-lora font-medium text-dark md:text-normal dark:text-light text-2xl lg:text-4xl"
        >
          Hey, I am Karthik
        </span>
        <span
          class="block py-1 font-lora font-medium text-accent text-lg md:text-xl lg:text-2xl"
        >
          Software & Cloud Devops Engineer
        </span>
      </article>
      <article
        class="max-w-none text-dark text-md dark:text-light prose-a:text-accent leading-relaxed prose"
      >
        <div class="pt-4">
          I am an engineer from India, currently working as a <span
            class="font-semibold"
            >Devops II Engineer
          </span> at
          <a
            class="text-accent hover:underline"
            target="_blank"
            href="https://www.sigmoid.com/">Sigmoid</a
          >, where I focus on cloud automation and infrastructure optimization.
          Previously, I worked as an Automation Engineer at <a
            class="text-accent hover:underline"
            target="_blank"
            href="https://www.oracle.com/">Oracle</a
          > , developing self-service tools and streamlining operational workflows
        </div>
        <div class="pt-4">
          I began my tech journey in 2016, when I was first introduced to
          programming during my college years. That initial exposure sparked a
          deep interest in the world of technology, leading me to explore
          various domains within software development. Over time, I found myself
          particularly drawn to web development—where I could bring ideas to
          life through clean and interactive user interfaces—and to DevOps,
          where I could automate, optimize, and scale systems efficiently. Since
          then, I've been consistently building my skills in both areas,
          blending front-end development with cloud automation to deliver
          end-to-end solutions that are both functional and scalable.
        </div>
        <div class="pt-4">
          In addition to my professional pursuits, I enjoy reading
          books—especially in the genres of mythological fiction and
          self-improvement.
        </div>
        <div class="pt-4">
          If you're interested in connecting, or simply wish to chat, I am
          always open for a conversation. You can connect with me through
          various social platforms:
        </div>
      </article>
      <article
        class="flex md:flex-row flex-col justify-center md:items-center gap-5 my-4 md:my-8"
      >
        <a
          href="/Resume_Karthik_Nayak.pdf"
          target="_blank"
          class="self-center px-6 md:px-4 py-3 md:py-2 border-[1px] border-dark md:border-[1px] hover:border-accent dark:border-light rounded-lg w-28 lg:w-28 hover:text-accent text-xs sm:text-sm text-center decoration-transparent capitalize tracking-wide md:tracking-widest"
          rel="noopener noreferrer"
        >
          Resume
        </a>
        <span
          class="flex flex-row md:flex-row flex-wrap justify-center md:justify-start items-start gap-3 text-dark text-opacity-0"
        >
          {
            social_data.map((item) => (
              <Social image={item.image} url={item.url} name={item.name} />
            ))
          }
        </span>
      </article>
    </section>
  </section>
</Layout>
