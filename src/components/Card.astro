---
import { db, Views, eq } from "astro:db";
interface Props {
  title: string;
  excerpt: string;
  href: string;
  date: number;
  slug: string;
}

const { href, title, excerpt, date, slug } = Astro.props;
const found = await db
  .select({
    count: Views.count,
  })
  .from(Views)
  .where(eq(Views.slug, slug));
const count = found[0]?.count || 0;
---

<li
  class="shadow-sm my-4 p-4 border border-gray-200 rounded-lg cursor-pointer list-none"
>
  <a href={href}>
    <div
      class="flex md:flex-row flex-col justify-between items-start md:items-center text-dark"
    >
      <h2 class="m-0 font-semibold text-lg md:text-xl">
        {title}
      </h2>
      <span class="flex gap-3">
        <span class="text-sm"
          >{
            new Date(date).toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "2-digit",
            })
          }
        </span>
        <span class="flex items-center gap-1 text-sm">
          <svg
            stroke="currentColor"
            fill="currentColor"
            stroke-width="0"
            viewBox="0 0 1024 1024"
            class="w-3 md:w-4 h-3 md:h-4"
            height="1em"
            width="1em"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              d="M942.2 486.2C847.4 286.5 704.1 186 512 186c-192.2 0-335.4 100.5-430.2 300.3a60.3 60.3 0 0 0 0 51.5C176.6 737.5 319.9 838 512 838c192.2 0 335.4-100.5 430.2-300.3 7.7-16.2 7.7-35 0-51.5zM512 766c-161.3 0-279.4-81.8-362.7-254C232.6 339.8 350.7 258 512 258c161.3 0 279.4 81.8 362.7 254C791.5 684.2 673.4 766 512 766zm-4-430c-97.2 0-176 78.8-176 176s78.8 176 176 176 176-78.8 176-176-78.8-176-176-176zm0 288c-61.9 0-112-50.1-112-112s50.1-112 112-112 112 50.1 112 112-50.1 112-112 112z"
            ></path></svg
          >
          {count}
        </span>
      </span>
    </div>
    <p class="mt-1 mb-0 text-gray-500 text-sm md:text-base">
      {excerpt}
    </p>
  </a>
</li>
