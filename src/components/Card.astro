---
import { db, Views, eq } from "astro:db";
import type { ComponentProps } from "../types";
import { formatDate } from "../utils/date";

const { href, title, excerpt, date, slug } = Astro.props;
const found = await db
  .select({
    count: Views.count,
  })
  .from(Views)
  .where(eq(Views.slug, slug));
const count = found[0]?.count || 0;
---

<li
  class="shadow-sm my-4 p-4 border border-gray-300 hover:border-accent rounded-lg font-assistant cursor-pointer list-none"
>
  <a href=`/blogs/${href}`>
    <div
      class="flex md:flex-row flex-col justify-between items-start md:items-center text-dark"
    >
      <h2
        class="m-0 font-inter font-semibold dark:text-light text-lg md:text-xl"
      >
        {title}
      </h2>
      <span class="flex gap-3 dark:text-secondary">
        <span class="text-sm">
          {formatDate(date)}
        </span>
      </span>
    </div>
    <p class="mt-1 mb-0 text-tertiary dark:text-secondary text-sm md:text-base">
      {excerpt}
    </p>
  </a>
</li>
