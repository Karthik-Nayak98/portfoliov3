---
import navItems from "../data/navitems.json";
---

<nav
  class="top-0 z-20 sticky bg-secondary dark:bg-dark mx-auto mb-2 px-4 md:px-12 lg:px-16 border-dark border-b-[1px] dark:border-light w-full max-w-7xl font-assistant"
>
  <div class="flex flex-wrap justify-between items-center mx-auto py-4">
    <a
      href="/"
      class="md:px-0 font-lora font-bold text-dark hover:text-accent dark:text-light text-2xl hover:underline"
    >
      Karthik Nayak
    </a>

    <section class="flex justify-end items-center gap-2 md:gap-8 px-2 md:px-0">
      <button
        id="menu-toggle"
        type="button"
        class="md:hidden inline-flex justify-center items-center hover:bg-gray-100 dark:hover:bg-gray-700 p-2 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:focus:ring-gray-600 w-10 h-10 text-gray-500 dark:text-gray-400"
        aria-controls="navbar-menu"
        aria-expanded="false"
      >
        <span class="sr-only">Open main menu</span>
        <svg
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 17 14"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"></path>
        </svg>
      </button>

      <!-- <div id="navbar-menu" class="hidden md:block w-full md:w-auto"> -->
      <div
        id="navbar-menu"
        class="hidden md:block top-full left-0 z-50 absolute md:relative w-full md:w-auto text-dark dark:text-light"
      >
        <ul
          class="flex md:flex-row flex-col md:space-x-8 bg-gray-50 md:bg-transparent md:dark:bg-gray-900 dark:bg-gray-800 md:mt-0 md:p-0 px-2 border border-gray-100 md:border-0 dark:border-gray-700"
        >
          {
            navItems.map((item) => (
              <li class="hover:underline">
                <a
                  href={item.path}
                  class="block md:hover:bg-transparent md:dark:hover:bg-transparent hover:bg-gray-100 dark:hover:bg-gray-700 md:p-0 px-3 py-2 rounded-md text-gray-800 md:hover:text-accent dark:text-light"
                >
                  {item.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <button
        type="button"
        id="theme-selector"
        class="bg-gray-500 dark:bg-light bg-opacity-10 dark:bg-opacity-10 p-2 rounded-lg text-dark dark:text-light"
      >
        <svg
          id="theme-toggle-dark-icon"
          stroke="currentColor"
          fill="currentColor"
          stroke-width="0"
          viewBox="0 0 24 24"
          class="dark:hidden hover:animate-spin"
          height="20"
          width="20"
          xmlns="http://www.w3.org/2000/svg"
          ><path
            d="M20.742 13.045a8.088 8.088 0 0 1-2.077.271c-2.135 0-4.14-.83-5.646-2.336a8.025 8.025 0 0 1-2.064-7.723A1 1 0 0 0 9.73 2.034a10.014 10.014 0 0 0-4.489 2.582c-3.898 3.898-3.898 10.243 0 14.143a9.937 9.937 0 0 0 7.072 2.93 9.93 9.93 0 0 0 7.07-2.929 10.007 10.007 0 0 0 2.583-4.491 1.001 1.001 0 0 0-1.224-1.224zm-2.772 4.301a7.947 7.947 0 0 1-5.656 2.343 7.953 7.953 0 0 1-5.658-2.344c-3.118-3.119-3.118-8.195 0-11.314a7.923 7.923 0 0 1 2.06-1.483 10.027 10.027 0 0 0 2.89 7.848 9.972 9.972 0 0 0 7.848 2.891 8.036 8.036 0 0 1-1.484 2.059z"
          ></path></svg
        >
        <svg
          id="theme-toggle-light-icon"
          stroke="currentColor"
          fill="currentColor"
          stroke-width="0"
          viewBox="0 0 24 24"
          class="hidden dark:inline hover:animate-spin"
          height="20"
          width="20"
          xmlns="http://www.w3.org/2000/svg"
          ><path
            d="M6.993 12c0 2.761 2.246 5.007 5.007 5.007s5.007-2.246 5.007-5.007S14.761 6.993 12 6.993 6.993 9.239 6.993 12zM12 8.993c1.658 0 3.007 1.349 3.007 3.007S13.658 15.007 12 15.007 8.993 13.658 8.993 12 10.342 8.993 12 8.993zM10.998 19h2v3h-2zm0-17h2v3h-2zm-9 9h3v2h-3zm17 0h3v2h-3zM4.219 18.363l2.12-2.122 1.415 1.414-2.12 2.122zM16.24 6.344l2.122-2.122 1.414 1.414-2.122 2.122zM6.342 7.759 4.22 5.637l1.415-1.414 2.12 2.122zm13.434 10.605-1.414 1.414-2.122-2.122 1.414-1.414z"
          ></path></svg
        >
      </button>
    </section>
  </div>

  <script is:inline>
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("navbar-menu");

    toggle?.addEventListener("click", () => {
      const isExpanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", !isExpanded);
      menu.classList.toggle("hidden");
    });

    // Toggle between light and dark mode.
    document.getElementById("theme-selector")?.addEventListener("click", () => {
      if (localStorage.theme === "dark") {
        localStorage.theme = "light";
        document.documentElement.classList.remove("dark");
      } else {
        localStorage.theme = "dark";
        document.documentElement.classList.add("dark");
      }
    });
  </script>
</nav>
